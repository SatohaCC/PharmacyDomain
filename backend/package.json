{
  "name": "pharmacydomain-api",
  "private": true,
  "scripts": {
    "dev": "docker compose --project-directory .. up api",
    "dev:local": "node ../scripts/backend.mjs run --env-file ../.env uvicorn app.dev_main:create_dev_app --factory --port 8000 --reload",
    "sync": "node ../scripts/backend.mjs sync --locked",
    "lint": "node ../scripts/backend.mjs run ruff check . && pnpm run lint:boundaries && pnpm run lint:domain && pnpm run lint:domain:harness && pnpm run lint:application && pnpm run lint:application:harness",
    "lint:boundaries": "node ../scripts/backend.mjs run ruff check --no-cache --ignore-noqa --select TID251,TID252,F403 app/domain app/application",
    "format:check": "node ../scripts/backend.mjs run ruff format --check .",
    "typecheck": "node ../scripts/backend.mjs run mypy app tests tools",
    "imports": "node ../scripts/backend.mjs run lint-imports --cache-dir ../.cache/import-linter",
    "test": "node ../scripts/backend.mjs run pytest -q",
    "test:integration": "node ../scripts/backend.mjs run pytest -m integration -q",
    "lint:domain": "node ../scripts/backend.mjs run python -m tools.check_domain_architecture",
    "lint:domain:harness": "node ../scripts/backend.mjs run pytest tests/tools/test_domain_harness.py -q",
    "lint:application": "node ../scripts/backend.mjs run python -m tools.check_application_architecture",
    "lint:application:harness": "node ../scripts/backend.mjs run pytest tests/tools/test_application_harness.py -q"
  }
}
