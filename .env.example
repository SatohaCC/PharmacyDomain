# Compose 開発用の PostgreSQL 設定。実運用の資格情報は Secret 管理へ置く。
POSTGRES_DB=pharmacydomain
POSTGRES_USER=pharmacydomain
POSTGRES_PASSWORD=pharmacydomain-dev-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pharmacydomain:pharmacydomain-dev-password@postgres:5432/pharmacydomain

# 開発用の固定トークン認証。compose の api サービス（開発用起動点）だけが読む。
# 本番の起動点 app.main:app はこれらを読まず、認証基盤が接続されるまで401を返す。
DEV_ACTOR_TOKEN=dev-actor-token
DEV_ACTOR_ROLE=vendor_system_admin
# DEV_ACTOR_ROLE=corporate_admin のときだけ必要。
DEV_ACTOR_CORPORATE_ID=
# 監査の追記先。実在する account_people / user_accounts の行を指す必要がある。
# 未設定だと開発用の起動点は起動しない（存在しない行を指すより早く落とす）。
# `uv run python -m tools.seed_dev_data` が投入し、貼れる形で出力する。
DEV_ACTOR_PERSON_ID=
DEV_ACTOR_ACCOUNT_ID=
# DEV_ACTOR_ROLE が店舗ロールのときだけ必要（カンマ区切り）。
DEV_ACTOR_STORE_IDS=
DEV_ACTOR_PRINCIPAL_ID=
API_PORT=8000

# 本番の認証基盤（外部IdP）。**本番の起動点 app.main:app だけが読む。**
# compose が起動する開発用の起動点はこれらを読まない（固定トークン認証のまま）。
#
# 項目そのものが無ければ「接続しない」という選択として扱い、業務操作は401のまま
# になる。そのため既定ではコメントアウトしてある。空の値を置くと設定の誤りとして
# 起動時に落ちる（繋いだつもりで誰も入れない状態を、動いたまま放置しない）。
# OIDC_ISSUER=https://your-tenant.example.com/
# OIDC_AUDIENCE=pharmacydomain
# OIDC_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# 受け付ける署名アルゴリズム（カンマ区切り・既定 RS256）。公開鍵方式のみ。
# OIDC_ALGORITHMS=RS256
# 期限検証で許す時計のずれ（秒・既定 0）。
# OIDC_LEEWAY_SECONDS=0
