{
  "name": "pharmacydomain",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --parallel --filter pharmacydomain-api --filter pharmacydomain-admin run dev",
    "dev:frontend": "pnpm --filter pharmacydomain-admin dev",
    "dev:backend": "pnpm --filter pharmacydomain-api dev",
    "dev:backend:local": "pnpm --filter pharmacydomain-api dev:local",
    "sync:backend": "pnpm --filter pharmacydomain-api sync",
    "build": "pnpm --filter pharmacydomain-admin build",
    "generate:api": "pnpm --filter pharmacydomain-admin generate:api",
    "lint": "pnpm lint:backend && pnpm lint:frontend",
    "lint:backend": "pnpm --filter pharmacydomain-api lint",
    "lint:frontend": "pnpm --filter pharmacydomain-admin lint",
    "format:check": "pnpm --filter pharmacydomain-api format:check",
    "imports": "pnpm --filter pharmacydomain-api imports",
    "typecheck": "pnpm typecheck:backend && pnpm typecheck:frontend",
    "typecheck:backend": "pnpm --filter pharmacydomain-api typecheck",
    "typecheck:frontend": "pnpm --filter pharmacydomain-admin typecheck",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "pnpm --filter pharmacydomain-api test",
    "test:frontend": "pnpm --filter pharmacydomain-admin test",
    "test:integration": "pnpm --filter pharmacydomain-api test:integration",
    "test:e2e": "pnpm --filter pharmacydomain-admin test:e2e",
    "test:e2e:install": "pnpm --filter pharmacydomain-admin exec playwright install --with-deps chromium",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm imports && pnpm test && pnpm build",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "docker compose run --rm api uv run --frozen alembic upgrade head",
    "db:seed": "docker compose run --rm api uv run --frozen python -m tools.seed_dev_data",
    "docker:build": "docker compose build api frontend",
    "docker:up": "docker compose up -d",
    "bootstrap": "pnpm install --frozen-lockfile && pnpm sync:backend",
    "storybook": "pnpm --filter pharmacydomain-admin storybook",
    "build:storybook": "pnpm --filter pharmacydomain-admin build:storybook",
    "test:stories": "pnpm --filter pharmacydomain-admin test:stories",
    "test:visual": "pnpm --filter pharmacydomain-admin test:visual"
  }
}
