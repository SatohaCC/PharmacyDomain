# Compose 開発用の PostgreSQL 設定。実運用の資格情報は Secret 管理へ置く。
POSTGRES_DB=pharmacydomain
POSTGRES_USER=pharmacydomain
POSTGRES_PASSWORD=pharmacydomain-dev-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pharmacydomain:pharmacydomain-dev-password@postgres:5432/pharmacydomain

# 開発用の固定トークン認証。compose の api サービス（開発用起動点）だけが読む。
# 本番の起動点 app.main:app はこれらを読まず、認証基盤が接続されるまで401を返す。
DEV_ACTOR_TOKEN=dev-actor-token
DEV_ACTOR_ROLE=vendor_system_admin
# DEV_ACTOR_ROLE=corporate_admin のときだけ必要。
DEV_ACTOR_CORPORATE_ID=
API_PORT=8000
